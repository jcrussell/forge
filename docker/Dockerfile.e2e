# Forge E2E Testing Container
# Self-contained environment for real GNOME Shell testing.
# Container setup derived from gnome-shell-pod (https://github.com/Schneegans/gnome-shell-pod),
# MIT license, by Simon Schneegans.
#
# FEDORA_VERSION maps to GNOME version:
#   39 -> GNOME 45, 40 -> GNOME 46, 41 -> GNOME 47,
#   42 -> GNOME 48, 43 -> GNOME 49, 44 -> GNOME 50, rawhide -> next devel cycle
#
# Build extension first on host: make build
# Then build container: docker build -f docker/Dockerfile.e2e -t forge-e2e .
#
# IMPORTANT: This container must be run with systemd as PID 1:
#   - Run in detached mode: docker run -td ...
#   - Use docker exec to run tests: docker exec $POD set-env.sh /app/scripts/run-tests.sh
#   - The Makefile handles this automatically with: make e2e-test

ARG FEDORA_VERSION=43
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

LABEL maintainer="Forge <forge@jmmaranan.com>"
LABEL description="E2E testing environment for Forge GNOME Shell extension"

# Install GNOME Shell + test dependencies in a single layer.
# gnome-shell: the shell itself plus gnome-extensions CLI.
# dbus-daemon: explicit dep because Fedora defaults to dbus-broker which doesn't
#   provide the dbus-daemon binary that start-user-session.sh uses.
# xorg-x11-server-Xvfb: virtual X server (start-user-session.sh runs gnome-shell --x11 on Xvfb).
# Forge test deps: xdotool, ImageMagick, gnome-text-editor, ibus, python3-pip, zenity.
# Build deps for dbus-python (removed after pip install).
RUN dnf install -y --setopt=install_weak_deps=False \
    gnome-shell \
    dbus-daemon \
    xorg-x11-server-Xvfb \
    mesa-dri-drivers \
    sudo \
    python3-pip \
    ImageMagick \
    gnome-text-editor \
    ibus \
    xdotool \
    zenity \
    gcc python3-devel dbus-devel glib2-devel \
    && pip3 install --no-cache-dir pytest PyGObject Pillow dbus-python \
    && dnf remove -y gcc python3-devel dbus-devel glib2-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Create gnomeshell user with passwordless sudo (from gnome-shell-pod)
RUN adduser -m -U -G users,adm gnomeshell && \
    echo "gnomeshell     ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Configure systemd for container use (from gnome-shell-pod)
RUN systemctl unmask systemd-logind.service && \
    systemctl set-default multi-user.target && \
    mkdir -p /etc/systemd/system/systemd-logind.service.d && \
    printf '[Service]\nProtectHostname=no\n' > /etc/systemd/system/systemd-logind.service.d/override.conf

# Set up extension directory
ARG UUID=forge@jmmaranan.com
ENV EXTENSION_PATH=/home/gnomeshell/.local/share/gnome-shell/extensions/${UUID}

# Copy pre-built extension (build on host first with: make build)
COPY --chown=gnomeshell:gnomeshell temp/ ${EXTENSION_PATH}/

# Copy test framework and scripts
WORKDIR /app
COPY --chown=gnomeshell:gnomeshell tests/e2e/ /app/tests/e2e/
COPY --chown=gnomeshell:gnomeshell docker/scripts/ /app/scripts/

RUN chmod +x /app/scripts/*.sh

# Set up test results directory
RUN mkdir -p /app/e2e-results && chown -R gnomeshell:gnomeshell /app

# Enable the Forge extension for the gnomeshell user via dconf
# This must be done before GNOME Shell starts so it loads the extension on startup
RUN mkdir -p /home/gnomeshell/.config/dconf && \
    chown -R gnomeshell:gnomeshell /home/gnomeshell/.config

# Pre-enable the extension by writing to dconf database directly
# Create a keyfile and compile it to binary format
RUN mkdir -p /tmp/dconf-db && \
    echo -e "[org/gnome/shell]\nenabled-extensions=['forge@jmmaranan.com']" > /tmp/dconf-db/00-forge && \
    dconf compile /home/gnomeshell/.config/dconf/user /tmp/dconf-db && \
    chown gnomeshell:gnomeshell /home/gnomeshell/.config/dconf/user && \
    rm -rf /tmp/dconf-db

# Enable lingering for gnomeshell user so user services can run without login
RUN mkdir -p /var/lib/systemd/linger && \
    touch /var/lib/systemd/linger/gnomeshell

# Install helper scripts to standard path
RUN cp /app/scripts/start-user-session.sh /usr/local/bin/start-user-session.sh && \
    cp /app/scripts/set-env.sh /usr/local/bin/set-env.sh && \
    chmod +x /usr/local/bin/start-user-session.sh /usr/local/bin/set-env.sh

# Systemd as PID 1 is required for GNOME Shell (systemd-logind, locale1, etc.)
CMD [ "/usr/sbin/init", "systemd.unified_cgroup_hierarchy=0" ]
